# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
# ...except the console build output: console/dist is committed on purpose
# (go:embed'ed into the binary, so plain `go build` needs no node).
!console/dist/
.eggs/

# Virtual envs
.venv/
venv/
env/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# LadyM runtime data
*.ladym.db
*.ladym.db-*
*.ladym.db.*
ladym.db
ladym.db-*
.ladym/
ladym_data/
ladym.toml

# IDE
.idea/
.vscode/
*.swp
.DS_Store

# Superpowers SDD scratch (progress ledger — git-ignored)
.superpowers/

# MCP config
.mcp.json

# agnet config
.claude*
.codex*

# Benchmarks
benchmarks/.cache/

# Go
/bin/
*.test
coverage.out
# Local shell profiles (may contain secrets)
.localProfile
