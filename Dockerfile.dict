# LadyM dict-baked image — a THIN DATA LAYER on top of any LadyM image.
#
#   docker build -f Dockerfile.dict \
#     --build-arg BASE=ladym-enterprise:v0.5.1 \
#     -t ladym-enterprise:v0.5.1-dict .
#
# The dictionary ships as FILES at /opt/ladym/dict (LADYM_DICT_DIR), not
# compiled into the binaries: every role (api/worker/console) reads the same
# 8.2MB copy, the layer is architecture-independent, and LadyM image
# upgrades don't touch it — rebuild this layer on top of the new base and
# the dict cache layer stays byte-identical.
#
# DICT_VARIANT picks the dictionary: zh (default) | zh_s | zh_t | jp.
# Files are sha256-pinned — MUST match the cjkDictRegistry pins in
# storage/cjk_dict.go (gse v1.0.2). Bump them together.
#
# Air-gapped alternative to the build-time downloads: place the pinned
# files under ./dict/ in the build context and they are COPYed in instead
# (no network needed); pass DICT_VARIANT accordingly.

ARG BASE=ladym-enterprise:local
ARG DICT_VARIANT=zh

# ---------------------------------------------------------------------------
# dict stage — download + sha256-verify + manifest. Mirrors mirror the Go
# code's order: jsDelivr first, GitHub raw fallback (jsDelivr 403s files
# over 20MB, which covers the jp dictionary).
# ---------------------------------------------------------------------------
FROM alpine:3.20 AS dict
ARG DICT_VARIANT
RUN apk add --no-cache curl ca-certificates
# Optional air-gap source: pinned files placed under ./dict/ in the build
# context (the repo ships it with just a .gitkeep) are preferred over the
# network downloads below.
COPY dict/ /src/dict/
# shellcheck disable=SC2016 — pins duplicated from storage/cjk_dict.go
RUN set -eux; \
    case "$DICT_VARIANT" in \
      zh)   files="s_1.txt t_1.txt" ;; \
      zh_s) files="s_1.txt" ;; \
      zh_t) files="t_1.txt" ;; \
      jp)   files="jp.txt" ;; \
      *) echo "unknown DICT_VARIANT: $DICT_VARIANT (want zh|zh_s|zh_t|jp)" >&2; exit 1 ;; \
    esac; \
    mkdir -p /opt/ladym/dict; \
    cd /opt/ladym/dict; \
    for f in $files; do \
      case "$f" in \
        s_1.txt) rel=data/dict/zh/s_1.txt; sum=2b3063ec552327520bee3c0c5819d6e131ab3db50a60b94641ec90f611c24bcd ;; \
        t_1.txt) rel=data/dict/zh/t_1.txt; sum=2c84cef353d2daac62cc62bbeabab6b6a8866cfee8f9f88901e00ed66ed208c6 ;; \
        jp.txt)  rel=data/dict/jp/dict.txt; sum=b7de28abfda94ed009f1e7fc67333393a449825ca653a7eb101fee61dfeda4ed ;; \
      esac; \
      if [ -f "/src/dict/$f" ]; then \
        cp "/src/dict/$f" "$f"; \
      else \
        curl -fsSL --retry 3 "https://cdn.jsdelivr.net/gh/go-ego/gse@v1.0.2/$rel" -o "$f" \
          || curl -fsSL --retry 3 "https://raw.githubusercontent.com/go-ego/gse/v1.0.2/$rel" -o "$f"; \
      fi; \
      echo "$sum  $f" | sha256sum -c -; \
    done; \
    printf '{"version":"gse-v1.0.2","variant":"%s"}\n' "$DICT_VARIANT" > manifest.json

# ---------------------------------------------------------------------------
# final stage — base image + dict files + env. Works for any BASE (the
# distroless enterprise image, or anything else that runs LadyM).
# ---------------------------------------------------------------------------
FROM ${BASE}
COPY --from=dict /opt/ladym/dict /opt/ladym/dict
ENV LADYM_DICT_DIR=/opt/ladym/dict
